
document.addEventListener("DOMContentLoaded", () => {
  const sidebar = document.getElementById("sidebar");
  const menuButton = document.getElementById("menuButton");

  // Mobile sidebar
  if (sidebar && menuButton) {
    menuButton.addEventListener("click", () => {
      sidebar.classList.toggle("open");
    });

    document.addEventListener("click", (event) => {
      if (
        window.innerWidth <= 760 &&
        sidebar.classList.contains("open") &&
        !sidebar.contains(event.target) &&
        !menuButton.contains(event.target)
      ) {
        sidebar.classList.remove("open");
      }
    });
  }

  // Load the registered member's display name if available.
  const userNameElement = document.getElementById("userName");
  const welcomeNameElement = document.getElementById("welcomeName");

  let displayName = "Member";

  try {
    const savedUser = localStorage.getItem("grovantaUser");

    if (savedUser) {
      const user = JSON.parse(savedUser);

      if (user && typeof user.first_name === "string") {
        displayName = user.first_name.trim() || "Member";
      } else if (user && typeof user.firstName === "string") {
        displayName = user.firstName.trim() || "Member";
      }
    }
  } catch (error) {
    console.warn("Unable to read saved profile information.");
  }

  if (userNameElement) {
    userNameElement.textContent = displayName;
  }

  if (welcomeNameElement) {
    welcomeNameElement.textContent = displayName + "!";
  }

  // Dashboard announcements are loaded from the page's existing
  // announcement container when available.
  const announcementList = document.getElementById("announcementList");

  if (announcementList) {
    announcementList.setAttribute("aria-live", "polite");
  }
});
