/* PAGE NAVIGATION */

function showPage(pageId, button = null) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.remove("active");
  });

  const selectedPage = document.getElementById(pageId);

  if (!selectedPage) {
    console.warn("GROVANTA: Page not found:", pageId);
    return;
  }

  selectedPage.classList.add("active");

  document.querySelectorAll(".adminNav button").forEach(item => {
    item.classList.remove("selected");
  });

  if (button) {
    button.classList.add("selected");
  }

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

/* USER DASHBOARD */

function openUser() {
  showPage("user");
}

/* ADMIN PREVIEW */

function openAdmin() {
  showPage("admin");
}

/* PRODUCT DISPLAY */

function renderProducts() {
  const productContainer = document.getElementById("productList");

  if (!productContainer) return;

  productContainer.replaceChildren();

  GROVANTA_PRODUCTS.forEach(product => {
    const card = document.createElement("div");
    card.className = "card";

    const heading = document.createElement("h3");
    heading.textContent = product.name;

    const amount = document.createElement("h2");
    amount.style.color = "#b66dff";
    amount.textContent = formatNaira(product.amount);

    const description = document.createElement("p");
    description.className = "muted";
    description.textContent = "Illustrative product amount";

    const badge = document.createElement("span");
    badge.className = "badge";
    badge.textContent = product.status;

    card.append(heading, amount, description, badge);
    productContainer.appendChild(card);
  });
}

/* CURRENCY FORMAT */

function formatNaira(amount) {
  return new Intl.NumberFormat("en-NG", {
    style: "currency",
    currency: "NGN",
    maximumFractionDigits: 2
  }).format(amount);
}

/* ANNOUNCEMENT PREVIEW */

function previewAnnouncement() {
  const titleInput = document.getElementById("announcementTitle");
  const messageInput = document.getElementById("announcementMessage");
  const preview = document.getElementById("announcementPreview");

  if (!titleInput || !messageInput || !preview) return;

  const title = titleInput.value.trim();
  const message = messageInput.value.trim();

  if (!title || !message) {
    notify("Please enter an announcement title and message.");
    return;
  }

  const card = document.createElement("div");
  card.className = "card";

  const heading = document.createElement("h3");
  heading.textContent = title;

  const body = document.createElement("p");
  body.textContent = message;

  const label = document.createElement("span");
  label.className = "badge";
  label.textContent = "Preview only";

  card.append(heading, body, label);
  preview.replaceChildren(card);
}

/* DEMO NOTIFICATIONS */

function notify(message) {
  let notification = document.getElementById("grovantaNotification");

  if (!notification) {
    notification = document.createElement("div");
    notification.id = "grovantaNotification";

    Object.assign(notification.style, {
      position: "fixed",
      bottom: "95px",
      left: "50%",
      transform: "translateX(-50%)",
      background: "#39215b",
      color: "#ffffff",
      padding: "13px 18px",
      borderRadius: "10px",
      zIndex: "100",
      width: "max-content",
      maxWidth: "90%",
      fontSize: "13px",
      textAlign: "center"
    });

    document.body.appendChild(notification);
  }

  notification.textContent = message;
  notification.classList.remove("hidden");
}

