
.dashboard-container {
  max-width: 1200px;
  margin: auto;
  padding: 35px 6%;
}

.dashboard-welcome {
  margin-bottom: 30px;
}

.dashboard-welcome h1 {
  font-size: 32px;
  margin: 12px 0;
}

.dashboard-welcome p {
  color: #aaa0ba;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.dashboard-card {
  padding: 25px;
  background: #171225;
  border: 1px solid #38254d;
  border-radius: 16px;
}

.dashboard-card h3 {
  color: #c9a1f5;
  font-size: 15px;
  margin-bottom: 15px;
}

.dashboard-card .amount {
  font-size: 27px;
  font-weight: 800;
}

.dashboard-card p {
  color: #aaa0ba;
  font-size: 13px;
  margin-top: 8px;
}

.dashboard-menu {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-top: 30px;
}

.dashboard-menu a {
  display: block;
  padding: 18px;
  text-align: center;
  background: #211631;
  border: 1px solid #49305f;
  border-radius: 12px;
  color: #e8d9fa;
}

.dashboard-menu a:hover {
  background: #38204f;
  border-color: #a855f7;
}

.dashboard-notice {
  padding: 20px;
  margin-top: 30px;
  background: #211631;
  border-left: 4px solid #a855f7;
  border-radius: 10px;
  color: #c9bfd5;
  font-size: 13px;
}

@media (max-width: 700px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-menu {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-welcome h1 {
    font-size: 26px;
  }
}
