
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GROVANTA | Referrals</title>

  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="dashboard.css">
  <link rel="stylesheet" href="referrals.css">
</head>

<body>

  <header class="header">
    <div class="logo">GROVANTA</div>
    <nav>
      <a href="index.html">Home</a>
      <a href="dashboard.html">Dashboard</a>
      <a href="profile.html">My Profile</a>
    </nav>
  </header>

  <main class="referrals-container">

    <section class="referrals-header">
      <span class="admin-label">REFERRAL CENTER</span>
      <h1>My Referrals</h1>
      <p>View your referral information and activity.</p>
    </section>

    <section class="referral-stats">

      <div class="referral-stat-card">
        <p>Total Referrals</p>
        <h2>0</h2>
      </div>

      <div class="referral-stat-card">
        <p>Active Referrals</p>
        <h2>0</h2>
      </div>

      <div class="referral-stat-card">
        <p>Referral Balance</p>
        <h2>₦0.00</h2>
      </div>

    </section>

    <section class="referral-link-card">

      <h2>Your Referral Code</h2>

      <p>
        Your personal referral code will appear here
        after secure account registration.
      </p>

      <div class="referral-code-display">
        Not generated yet
      </div>

      <h3>Your Referral Link</h3>

      <div class="referral-link-display">
        Referral link unavailable until account setup.
      </div>

      <button type="button"
        onclick="alert('Referral sharing will be enabled after backend integration.')">
        Copy Referral Link
      </button>

    </section>

    <section class="referral-history-card">

      <h2>Referral Activity</h2>

      <p>People who join through your referral link will appear here.</p>

      <div class="referral-empty">
        No referral activity available yet.
      </div>

    </section>

    <div class="referral-notice">
      Referral information will be displayed using verified account
      records after secure backend integration. No referral rewards
      are generated by this page.
    </div>

    <a href="dashboard.html" class="referral-back">
      ← Back to Dashboard
    </a>

  </main>

  <footer class="footer">
    <p>© 2026 GROVANTA. All rights reserved.</p>
  </footer>

</body>
</html>
